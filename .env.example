# Postgres connection string. Local dev: postgresql://user:pass@localhost:5432/dbname
# Production: a hosted Postgres connection string (e.g. Neon: postgresql://user:pass@ep-xxxx.neon.tech/dbname?sslmode=require)
DATABASE_URL=

# Shared secret required in the Authorization header for the /api/cron/ensure-puzzles route
CRON_SECRET=

# Optional: only used for metadata enrichment (genre/year backfill), never for audio
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google AdSense publisher id, e.g. ca-pub-xxxxxxxxxxxxxxxx (leave blank to keep ad slots disabled)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
