# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string (local: postgresql://user:pass@localhost:5432/db;
# hosted, e.g. Render's "External Database URL" or Neon: add ?sslmode=require).
# Use a least-privilege role.
DATABASE_URL=

# Connections each server instance may hold open (1-20). Defaults to 3 in
# production and 10 in development; leave blank unless you hit connection limits.
DB_POOL_MAX=

# Public origin of the app, used for auth callbacks, emails and CSRF checks.
BETTER_AUTH_URL=http://localhost:3000

# Random secrets, 32+ chars each (required in production):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
DEVICE_COOKIE_SECRET=

# Puzzle days roll over at midnight in this IANA timezone.
PUZZLE_TIMEZONE=Asia/Kolkata

# Comma-separated emails promoted to admin on their first verified sign-in.
ADMIN_EMAILS=

# ── Sign-in ─────────────────────────────────────────────────────────────────
# Google OAuth client (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google).
# Leave blank to offer email links only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend API key for magic-link emails. In development the links are printed to
# the server console when this is blank. In production, leaving it blank makes
# sign-in Google-only (the email form is hidden).
RESEND_API_KEY=
EMAIL_FROM=GuessTheBollySong <no-reply@yourdomain.com>

# ── Site ────────────────────────────────────────────────────────────────────
# Shown in the footer and the legal pages; how rights holders and players reach you.
NEXT_PUBLIC_CONTACT_EMAIL=

# Premium is parked. Leave blank; only set to "true" once a payment path exists.
PREMIUM_ENABLED=

# ── Ops ─────────────────────────────────────────────────────────────────────
# Bearer token the daily scheduler (Vercel Cron, or another host's job) sends to
# /api/cron/ensure-puzzles.
CRON_SECRET=

# ── AdSense (leave blank to disable ads) ────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_RESULT=
NEXT_PUBLIC_ADSENSE_SLOT_ARCHIVE=
NEXT_PUBLIC_ADSENSE_SLOT_STATS=
